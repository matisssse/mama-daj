# MySQL Database Configuration
# ВАЖНО: Измените эти пароли на надежные перед использованием!
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE_THIS_DB_PASSWORD

# WordPress Configuration
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
# Пароль должен совпадать с MYSQL_PASSWORD выше
WORDPRESS_DB_PASSWORD=CHANGE_THIS_DB_PASSWORD

# Article Service Configuration
# OpenAI API ключ для рерайта статей (обязательно)
OPENAI_API_KEY=your_openai_api_key_here
# Модель OpenAI (по умолчанию gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo

# WordPress API настройки (создайте пользователя в WordPress с правами публикации)
WORDPRESS_URL=http://wordpress
WORDPRESS_API_USER=your_wordpress_username
WORDPRESS_API_PASSWORD=your_wordpress_application_password

# Настройки публикации
# Статус постов: draft (черновик) или publish (опубликовать сразу)
WORDPRESS_POST_STATUS=draft
# ID категории по умолчанию
WORDPRESS_DEFAULT_CATEGORY=1

# Настройки расписания
# Время запуска парсинга в формате HH:MM (24-часовой формат)
SCHEDULE_TIME=03:00
# Запускать парсинг при старте контейнера (true/false)
RUN_ON_STARTUP=false
# Задержка между публикациями в секундах (для естественности)
PUBLISH_DELAY_SECONDS=300

# Дополнительные настройки
# Добавлять ссылку на источник в конец поста (true/false)
ADD_SOURCE_LINK=false
